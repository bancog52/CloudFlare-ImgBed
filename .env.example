# 仅用于本地记录与本地调试，请勿提交真实密钥到 Git
# 部署到 Cloudflare Pages 时，请将以下变量填入 Pages -> Settings -> Environment variables

# 管理后台与网页上传登录密码（未配置时自动兼容复用现有的 BASIC_PASS）
ADMIN_PASSWORD=

# API 上传密钥（供 Typora / Obsidian / 脚本通过 Authorization: Bearer <API_TOKEN> 调用）
API_TOKEN=

# Telegram 机器人 Token（向 @BotFather 申请）与目标频道/群组 Chat ID（如 -100xxxxxxxxxx）
TG_BOT_TOKEN=
TG_CHAT_ID=

# 可选：Telegram API 反代域名（不含 https://，留空则直连 api.telegram.org）
TG_PROXY_URL=

# 仅用于本地记录与本地调试，请勿提交真实密钥到 Git
# 部署到 Cloudflare Pages 时，请将以下变量填入 Pages -> Settings -> Environment variables

# 管理后台与网页上传登录密码（未配置时自动兼容复用现有的 BASIC_PASS）
ADMIN_PASSWORD=

# API 上传密钥（供 Typora / Obsidian / 悬浮球通过 Authorization: Bearer <API_TOKEN> 调用）
API_TOKEN=

# Cloudflare Turnstile 人机验证密钥
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 本地脚本上传时的原图按月备份根目录（仅本地生效）
LOCAL_BACKUP_DIR=D:\OneDrive\文档\archive\imghub_bk
